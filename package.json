{
  "name": "pouchdb-adapter-node-sqlite",
  "version": "2.0.0",
  "description": "PouchDB adapter using the Node.js built-in node:sqlite module for Electron applications",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "test": "mkdir -p tmp && mocha tests --require tests/node.setup.js",
    "test:debug": "mkdir -p tmp && mocha tests --require tests/node.setup.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pouchdb",
    "adapter",
    "sqlite",
    "sqlite3",
    "electron",
    "database",
    "node:sqlite"
  ],
  "author": "Takuya Matsuyama<t@inkdrop.app>",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkdropapp/pouchdb-adapter-node-sqlite.git"
  },
  "bugs": {
    "url": "https://github.com/inkdropapp/pouchdb-adapter-node-sqlite/issues"
  },
  "homepage": "https://github.com/inkdropapp/pouchdb-adapter-node-sqlite#readme",
  "dependencies": {
    "debug": "^4.4.3",
    "pouchdb-adapter-utils": "^9.0.0",
    "pouchdb-binary-utils": "^9.0.0",
    "pouchdb-errors": "^9.0.0",
    "pouchdb-json": "^9.0.0",
    "pouchdb-merge": "^9.0.0",
    "pouchdb-utils": "^9.0.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.2.0",
    "@types/pouchdb": "^6.4.2",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "mocha": "^11.8.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "pouchdb-adapter-http": "^9.0.0",
    "pouchdb-core": "^9.0.0",
    "pouchdb-mapreduce": "^9.0.0",
    "pouchdb-replication": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
